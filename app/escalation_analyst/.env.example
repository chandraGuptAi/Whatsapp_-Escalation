# Append selected values to the existing Python .env; never replace it.
# Default is a separate SQLite file. Optional PostgreSQL URL uses a private schema.
ESCALATION_DATABASE_URL=
ESCALATION_SQLITE_PATH=
# Native Python client; one backend worker owns the linked-device session.
WHATSAPP_AUTOSTART=true
WHATSAPP_SESSION_PATH=data/whatsapp-session.sqlite3
WHATSAPP_HISTORY_LIMIT=50
# Optional import API only; not used by the native WhatsApp client.
ESCALATION_INGEST_SECRET=
ESCALATION_DEEPSEEK_API_KEY=
ESCALATION_DEEPSEEK_MODEL=deepseek-v4-pro
ESCALATION_DEEPSEEK_BASE_URL=https://api.deepseek.com
ESCALATION_DEEPSEEK_REASONING=max
ESCALATION_DEEPSEEK_MAX_TOKENS=80000
GEMINI_API_KEY=
GEMINI_MEDIA_MODEL=gemini-3.1-flash-lite
RECIPIENT_NUMBER=
ESCALATION_SCHEDULER_ENABLED=false
ESCALATION_RETENTION_DAYS=30
# Master runs (all optional; defaults shown). Benchmark real provider limits before raising concurrency.
MASTER_ANALYSIS_CONCURRENCY=4
MASTER_AI_MAX_CONCURRENCY=4
MASTER_AI_MAX_RETRIES=2
MASTER_AI_RETRY_BACKOFF_SECONDS=2
ESCALATION_AI_TIMEOUT_SECONDS=1500
MASTER_PROGRESS_POLL_INTERVAL_HINT=2
MASTER_ANALYSIS_INCREMENTAL_ENABLED=true
MASTER_ANALYSIS_STRICT_VALIDATION=true
MASTER_PROMPT_MAX_CHARS=600000
ESCALATION_JOB_STALE_SECONDS=300
