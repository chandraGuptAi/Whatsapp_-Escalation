APP_ENV=dev
# Service connects as app_user (never the owner role), so row-level security always applies.
DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/whatsapp_escalation
DB_POOL_MIN=2
DB_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:6379/0

# Random secrets, at least 32 characters each. Never commit real values.
JWT_SECRET=
API_KEY_PEPPER=
# base64 of 32 random bytes: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_PER_MINUTE=120

# Comma-separated module keys to switch off for this whole deployment, e.g. performance,logistics
DISABLED_MODULES=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MEDIA_MODEL=gemini-3.1-flash-lite
AI_MAX_INPUT_TOKENS=60000

WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=900
