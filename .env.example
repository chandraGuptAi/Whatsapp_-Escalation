# Same secret must be set on main backend. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ESCALATION_SERVICE_TOKEN=
WHATSAPP_AUTOSTART=false
WHATSAPP_SESSION_PATH=data/whatsapp-session.sqlite3
# Required: application data is stored in PostgreSQL.
ESCALATION_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/escalation_analyst
ESCALATION_INGEST_SECRET=
ESCALATION_DEEPSEEK_API_KEY=
ESCALATION_DEEPSEEK_MODEL=deepseek-v4-pro
ESCALATION_DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MEDIA_MODEL=gemini-3.1-flash-lite
RECIPIENT_NUMBER=
ESCALATION_SCHEDULER_ENABLED=false

# Gated rollout: keep legacy until reviewed-dataset and provider benchmarks pass.
ESCALATION_ENGINE_MODE=legacy
ESCALATION_HYBRID_ENABLED=false
ESCALATION_AI_ROUTING_ENABLED=false
ESCALATION_INCREMENTAL_ENABLED=false
ESCALATION_SHADOW_ENABLED=false
ESCALATION_LIGHT_REASONING=
ESCALATION_COMPLEX_REASONING=
ESCALATION_HYBRID_MAX_TOKENS=8192
ESCALATION_DEEP_AWB_THRESHOLD=4
ESCALATION_AI_MIN_INTERVAL_SECONDS=0

# Master throughput. Limits are bounded across groups and all provider callers.
MASTER_ANALYSIS_CONCURRENCY=8
MASTER_AI_MAX_CONCURRENCY=8
# Faster group calls; final master and direct group reports retain global reasoning.
# Blank inherits ESCALATION_DEEPSEEK_REASONING. Lower effort needs quality validation.
MASTER_GROUP_REASONING=low
